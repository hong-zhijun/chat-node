# ────────────────────────────────────────────────────────────────────
# Nodex 私聊系统 · 环境变量配置示例
# 使用方法：复制本文件为 .env，填入真实值后启动 docker compose
#   cp .env.example .env
# ────────────────────────────────────────────────────────────────────

# ── 必须修改的安全配置 ──────────────────────────────────────────────
# 管理员登录密钥（建议 32 位以上随机字符串）
# 生成命令：openssl rand -hex 32
ADMIN_KEY=请替换为长随机字符串

# JWT 签名密钥（建议 64 位以上随机字符串）
# 生成命令：openssl rand -hex 64
JWT_SECRET=请替换为另一个长随机字符串

# ── 可选配置 ────────────────────────────────────────────────────────
JWT_EXPIRES_IN=30d

# ── Shared-file object storage (Qiniu Kodo, optional) ───────────────────────
# Keep SHARE_STORAGE_DRIVER=local until the Kodo bucket and access domain are ready.
# Only newly uploaded shared files use Qiniu; chat attachments, stickers, and
# all existing files remain on local disk.
SHARE_STORAGE_DRIVER=local
QINIU_ACCESS_KEY=
QINIU_SECRET_KEY=
QINIU_BUCKET=
# Example: https://files.example.com (must be bound to the bucket)
QINIU_DOMAIN=
# Optional values: z0, z1, z2, na0, as0, cn-east-2. Leave empty for auto discovery.
QINIU_ZONE=
# Signed direct-download URL lifetime in seconds.
QINIU_DOWNLOAD_EXPIRES_SECONDS=300
# Shared files are uploaded by the browser straight to Kodo (multipart v2), so
# Nginx client_max_body_size and the server's 200 MB multer limit do not apply.
# Maximum shared-file size in bytes (default 10 GiB).
QINIU_DIRECT_UPLOAD_MAX_BYTES=10737418240
# Lifetime of each browser upload token in seconds; long uploads refresh it.
QINIU_DIRECT_UPLOAD_TOKEN_EXPIRES_SECONDS=7200
# Optional HTTPS upload endpoint for browsers, e.g. https://upload-z2.qiniup.com.
# Leave empty to derive it from QINIU_ZONE or the bucket's region.
QINIU_UPLOAD_HOST=
